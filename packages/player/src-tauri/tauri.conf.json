{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Aurora",
    "mainBinaryName":  "aurora-music-player",
    "version":  "1.47.43",
    "identifier":  "com.nuclearplayer",
    "build":  {
                  "frontendDist":  "../dist",
                  "devUrl":  "http://localhost:5173",
                  "beforeDevCommand":  "vite",
                  "beforeBuildCommand":  "cd ../.. \u0026\u0026 pnpm --filter @nuclearplayer/player build:frontend"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "Aurora Music Player",
                                    "width":  1280,
                                    "height":  720,
                                    "maximized":  true,
                                    "resizable":  true,
                                    "fullscreen":  false,
                                    "visible":  false
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "category":  "Music",
                   "shortDescription":  "Aurora Music Player",
                   "longDescription":  "Aurora is a free, modern music player without ads or tracking. Search for any song or artist, build playlists, and start listening.",
                   "copyright":  "Copyright 2026 Aurora",
                   "homepage":  "https://github.com/danidetenerife/nucelar",
                   "createUpdaterArtifacts":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/icon.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "linux":  {
                                 "deb":  {
                                             "depends":  [

                                                         ]
                                         },
                                 "appimage":  {
                                                  "bundleMediaFramework":  true
                                              },
                                 "rpm":  {
                                             "epoch":  0,
                                             "files":  {

                                                       },
                                             "release":  "1"
                                         }
                             },
                   "macOS":  {
                                 "signingIdentity":  "-",
                                 "dmg":  {
                                             "appPosition":  {
                                                                 "x":  180,
                                                                 "y":  170
                                                             },
                                             "applicationFolderPosition":  {
                                                                               "x":  480,
                                                                               "y":  170
                                                                           },
                                             "windowSize":  {
                                                                "width":  660,
                                                                "height":  400
                                                            }
                                         }
                             },
                   "windows":  {
                                   "nsis":  {
                                                "installMode":  "currentUser"
                                            }
                               }
               },
    "plugins":  {
                    "updater":  {
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFRDUzRDZCMEREQkRGQTIKUldTaTM5c05hejNWbnBFekRabGU3ZVhlTXN3cGg1bHQ0VTdhQUNibjZoaVU2WlhyZnBUTFBWNFYK",
                                    "endpoints":  [
                                                      "https://github.com/danidetenerife/nucelar/releases/latest/download/latest.json"
                                                  ]
                                }
                }
}